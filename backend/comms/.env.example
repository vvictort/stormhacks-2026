# Copy to .env and fill in. Texts work without any ElevenLabs settings; calls need them.

COMMS_PORT=3001
# Base URL this server is reachable at (used to build tracked scam links).
PUBLIC_BASE_URL=http://localhost:3001
# Where the React app runs (CORS origin + target of the "this was a simulation" redirect).
FRONTEND_BASE_URL=http://localhost:5173
# Frontend route shown after a scam link is tapped. Placeholder until agreed with Victor.
CAUGHT_PATH=/caught

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys). Never expose this to the browser.
ELEVENLABS_API_KEY=
# Filled in after running `npm run setup:agent` once.
ELEVENLABS_AGENT_ID=
# LLM the agent runs on (must be one of ElevenLabs' allowed model ids).
ELEVENLABS_LLM=gemini-2.5-flash
# Optional default voice for the agent; leave empty to use ElevenLabs' default.
ELEVENLABS_DEFAULT_VOICE_ID=
# Hard cap on simulated call length.
CALL_MAX_SECONDS=180

# Simulated texts: nudge after this much silence, end the thread after this much inactivity.
TEXT_FOLLOWUP_SEC=120
TEXT_IDLE_END_SEC=600
