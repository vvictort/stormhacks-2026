# Copy to backend/.env and replace placeholders. Never commit real credentials.

# TigerData connection. Replace the host and port with your service's values.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://USERNAME:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
# For a custom service CA, append inside the URL quotes:
# &sslrootcert=/absolute/path/to/tigerdata-ca.pem
# Keep certificate and hostname verification enabled.

# Match VITE_FIREBASE_PROJECT_ID in frontend/.env.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Express server and allowed frontend origin (no path or trailing slash).
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production: use NODE_ENV=production and an HTTPS APP_ORIGIN behind an HTTPS proxy.

# Optional: dedicated local integration-test database; its name must end in _test.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/tellio_test"

# Optional: shared secret for comms -> backend calls on /api/internal/* (sent as X-Internal-Token).
# Use the same value in comms. At least 32 characters, e.g. `openssl rand -hex 32`. Unset disables the internal routes.
INTERNAL_API_TOKEN=

# Optional: Google AI Studio key for Gemini call-scenario generation. Without it, built-in scenarios are used.
GEMINI_API_KEY=
