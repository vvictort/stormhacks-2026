HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/scam_training
# For TigerData use its supplied TLS connection URL; certificate verification stays enabled.
PERSONALIZATION_URL=http://127.0.0.1:8000
# Set the same secret in both services. This is not a user authentication token.
PERSONALIZATION_SERVICE_KEY=replace-with-a-long-random-secret
# Optional path to the team's verified authentication middleware module.
# The module must export authenticate (an Express RequestHandler).
AUTH_MIDDLEWARE_MODULE=
