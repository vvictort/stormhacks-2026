# Firebase handles login. TigerData stores the authenticated user's personal profile.
# Copy to backend/.env; never commit real credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
DATABASE_URL="postgresql://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full"
# If the service uses its own CA, append inside the URL quotes:
# &sslrootcert=/absolute/path/to/tigerdata-ca.pem
# URL-encode password special characters and keep certificate verification enabled.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production requires an HTTPS APP_ORIGIN and an HTTPS reverse proxy.
