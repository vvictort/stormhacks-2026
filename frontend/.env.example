# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
# Copy to .env and fill in. VITE_FIREBASE_MEASUREMENT_ID is optional (Analytics is skipped without it).
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional: where the browser reaches the comms service. Defaults to /comms (the Vite dev proxy).
# VITE_COMMS_BASE_URL=
# Dev proxy target for /comms is the COMMS_URL shell variable (default http://localhost:3001); Vite doesn't read it from .env.
# COMMS_URL=
